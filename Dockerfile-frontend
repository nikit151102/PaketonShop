# ============================================
# Stage 1: Сборка приложения (builder)
# ============================================
# БЫЛО: FROM node:22-alpine AS builder
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
ARG VERSION_NUMBER_ARG=no-version
ENV VERSION_NUMBER=$VERSION_NUMBER_ARG
ENV TZ=Europe/Zurich
RUN npm run build

# ============================================
# Stage 2: Production образ (минимальный)
# ============================================
# БЫЛО: FROM node:22-alpine AS production
FROM node:20-alpine AS production

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --omit=dev && npm cache clean --force
COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production
ENV TZ=Europe/Zurich
ARG VERSION_NUMBER_ARG=no-version
ENV VERSION_NUMBER=$VERSION_NUMBER_ARG

EXPOSE 4000
CMD ["node", "dist/paketon-shop/server/server.mjs"]